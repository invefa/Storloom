<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Storloom.ToolFixture/Storloom.ToolFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Storloom.Core/Storloom.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="CopyToolFixture" AfterTargets="Build">
    <ItemGroup>
      <ToolFixtureFiles Include="../Storloom.ToolFixture/bin/$(Configuration)/net10.0/*" Exclude="../Storloom.ToolFixture/bin/$(Configuration)/net10.0/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolFixtureFiles)" DestinationFolder="$(OutDir)tool-fixture" />
  </Target>
</Project>
